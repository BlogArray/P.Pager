@using P.Pager.Mvc.Blazor.Example.Data

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>City</th>
            <th>Joined</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Member member in Items)
        {
            <tr>
                <td>@member.Id</td>
                <td>@member.Name</td>
                <td>@member.Email</td>
                <td>@member.City</td>
                <td>@member.Joined.ToString("d")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public IEnumerable<Member> Items { get; set; } = [];
}
